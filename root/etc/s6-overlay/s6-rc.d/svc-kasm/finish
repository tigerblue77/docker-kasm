#!/usr/bin/with-contenv bash
# shellcheck shell=bash

KASM_SESSIONS_STATE="/opt/kasm_sessions.state"

# Workspace sessions that are running or paused, followed by their helper
# containers, which may share a session's namespaces
mapfile -t SESSIONS < <({ docker ps -q --filter "label=kasm.kasmid"; docker ps -q --filter "label=kasm.helper.kasmid"; } | awk '!seen[$0]++')

# Record their state and addresses before anything else, so that svc-kasm can
# restore them even if the shutdown does not get to complete. Kasm routes to a
# session by the address it was created with and never refreshes it.
rm -f "${KASM_SESSIONS_STATE}"
if [[ ${#SESSIONS[@]} -gt 0 ]]; then
    docker inspect --format '{{.Id}} {{.State.Status}}{{range $network, $settings := .NetworkSettings.Networks}} {{$network}}={{$settings.IPAddress}}{{end}}' "${SESSIONS[@]}" > "${KASM_SESSIONS_STATE}.tmp" &&
        mv "${KASM_SESSIONS_STATE}.tmp" "${KASM_SESSIONS_STATE}"
fi

/opt/kasm/bin/stop

# Stop the sessions here rather than leaving them to dockerd's own shutdown,
# after which dockerd would restart them by itself on its next start, with
# whatever addresses happen to be free by then
if [[ ${#SESSIONS[@]} -gt 0 ]]; then
    docker stop "${SESSIONS[@]}" > /dev/null
fi
